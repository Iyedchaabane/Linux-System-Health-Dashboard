{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "task": "allow"
  },
  "agent": {
    "orchestrator": {
      "description": "Coordinates development tasks, delegates work to specialist agents, maintains the implementation plan, and reviews results.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "ls*": "allow"
        },
        "task": {
          "*": "deny",
          "linux-monitoring": "allow",
          "backend-python": "allow",
          "frontend-ui": "allow",
          "testing-qa": "allow",
          "code-reviewer": "allow"
        }
      }
    },
    "linux-monitoring": {
      "description": "Specializes in Linux system metrics, psutil, processes, storage, networking, sensors, and services.",
      "mode": "subagent",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "rm *": "deny",
          "sudo *": "deny",
          "pip *": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "uv run pytest*": "allow",
          "uv run ruff*": "allow",
          "uv run mypy*": "allow",
          "uv run lint-imports*": "allow",
          "make check*": "allow",
          "make test*": "allow",
          "make lint*": "allow",
          "make typecheck*": "allow",
          "make arch*": "allow"
        },
        "task": "deny"
      }
    },
    "backend-python": {
      "description": "Implements the Python and FastAPI backend, REST APIs, WebSockets, system metrics, error handling, and backend tests.",
      "mode": "subagent",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "rm *": "deny",
          "sudo *": "deny",
          "pip *": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "uv run pytest*": "allow",
          "uv run ruff*": "allow",
          "uv run mypy*": "allow",
          "uv run lint-imports*": "allow",
          "make check*": "allow",
          "make test*": "allow",
          "make lint*": "allow",
          "make typecheck*": "allow",
          "make arch*": "allow"
        },
        "task": "deny"
      }
    },
    "frontend-ui": {
      "description": "Implements the React, TypeScript, Vite, Tailwind CSS, charts, responsive layouts, and light and dark themes.",
      "mode": "subagent",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "rm *": "deny",
          "sudo *": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "npm run test*": "allow",
          "npm run lint*": "allow",
          "npm run typecheck*": "allow",
          "npm run build*": "allow"
        },
        "task": "deny"
      }
    },
    "testing-qa": {
      "description": "Validates backend and frontend behavior, runs tests, identifies regressions, and reports reproducible failures.",
      "mode": "subagent",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "rm *": "deny",
          "sudo *": "deny",
          "pip *": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "pytest*": "allow",
          "ruff*": "allow",
          "npm run test*": "allow",
          "npm run lint*": "allow"
        },
        "task": "deny"
      }
    },
    "code-reviewer": {
      "description": "Reviews changes for correctness, security, maintainability, performance, and regressions without modifying source files.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "grep *": "allow",
          "ls*": "allow",
          "*>*": "deny",
          "*--output*": "deny",
          "*tee *": "deny"
        },
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "skill": "allow",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny"
      }
    }
  }
}